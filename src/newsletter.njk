---
layout: base.njk
title: "Newsletter"
nav: "newsletter"
description: "The Celiac Sisters newsletter: cross-contamination tips, label-reading know-how, new restaurants, and recipes."
permalink: "newsletter/index.html"
---
<section class="page-header">
  <div class="container">
    <span class="eyebrow">Newsletter</span>
    <h1>Every issue, all in one place</h1>
    <p class="lead">New restaurants, recipes, and the label-reading tips that keep us safe — a few times a month.</p>
  </div>
</section>

<section>
  <div class="container" style="max-width:760px;">
    {% for issue in collections.newsletterIssues %}
    <div class="card" style="margin-bottom:24px;">
      <div class="card-body">
        <span class="eyebrow">Issue No. {{ issue.data.issue_number }} · {{ issue.data.date | readableDate }}</span>
        <h2 style="margin-top:6px;"><a href="{{ issue.url }}">{{ issue.data.title }}</a></h2>
        <p>{{ issue.data.summary }}</p>
        <a href="{{ issue.url }}">Read this issue &rarr;</a>
      </div>
    </div>
    {% endfor %}
  </div>
</section>

<section class="section-alt" id="subscribe">
  <div class="container">
    <div class="signup-box">
      <h2>Never miss an issue</h2>
      <p>New restaurants, recipes, and the label-reading tips that keep us safe — a few times a month, straight to your inbox.</p>
      <form class="signup-form" name="newsletter" method="POST" data-netlify="true">
        <input type="hidden" name="form-name" value="newsletter">
        <input type="text" name="first_name" placeholder="First name">
        <input type="email" name="email" placeholder="you@email.com" required>
        <button type="submit" class="btn btn-coral">Subscribe</button>
      </form>
    </div>
  </div>
</section>
